# Build-time defaults (Vite). At runtime /env.js (generated by the nginx entrypoint) overrides them.
VITE_OIDC_ISSUER=http://mock-oidc:8080/default
VITE_OIDC_CLIENT_ID=admin-1
VITE_OIDC_SCOPE=openid governance
# When set, OIDC endpoints are addressed through this same-origin prefix instead of discovery
# (needed locally because the browser cannot reach the issuer host; leave empty for a real IdP).
VITE_OIDC_ENDPOINT_BASE=/oidc/default
VITE_ROLES_CLAIM=roles
VITE_ADMIN_ROLE=governance-admin
VITE_AUDITOR_ROLE=governance-auditor
# Dev-only: allow pasting a bearer token (deploy/scripts/token.sh admin-1) instead of OIDC login.
VITE_DEV_TOKEN_LOGIN=true
