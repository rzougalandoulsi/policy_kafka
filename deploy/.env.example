# Copy to deploy/.env. Secrets are injected via environment, never baked into images.
KAFKA_ADMIN_PASSWORD=admin-secret
KAFKA_GOVERNANCE_PASSWORD=governance-secret
KAFKA_ORCHESTRATOR_PASSWORD=orchestrator-secret
KAFKA_PROCESSOR_PASSWORD=processor-secret
KAFKA_SR_PASSWORD=sr-secret
POSTGRES_PASSWORD=governance
OPA_BUNDLE_TOKEN=change-me-bundle-token
# Optional: build and run the private Orchestrator/Processor stand-ins (local modules, not in the public repository).
COMPOSE_PROFILES=simulators
