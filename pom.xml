<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>com.itland</groupId>
  <artifactId>platform</artifactId>
  <version>1.0</version>
  <packaging>pom</packaging>
  <name>Kafka resource-management platform</name>

  <modules>
    <module>contracts</module>
    <module>governance</module>
  </modules>

  <!-- The Orchestrator and Processor stand-ins are private local modules (git-ignored, not published). They join the
       reactor only when their directories exist, so a public checkout builds Governance without them. -->
  <profiles>
    <profile>
      <id>simulators</id>
      <activation>
        <file>
          <exists>${basedir}/orchestrator-simulator/pom.xml</exists>
        </file>
      </activation>
      <modules>
        <module>orchestrator-simulator</module>
        <module>processor-simulator</module>
      </modules>
    </profile>
  </profiles>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Overrides Spring Boot's managed org.apache.kafka:* so every module runs the same Confluent
         client build as the existing platform (the Orchestrator prototype pins 8.0.0-ce). -->
    <kafka.version>8.0.0-ce</kafka.version>
    <confluent.version>8.0.0</confluent.version>
    <avro.version>1.11.4</avro.version>
    <springdoc.version>3.2.0</springdoc.version>
    <!-- Embedded BPMN engine of the Governance approvals (ADR 0011). 8.0.0 is the first Flowable line built for
         Spring Boot 4 / Spring Framework 7 / Jackson 3; 7.x does not start on Boot 4. -->
    <flowable.version>8.0.0</flowable.version>
  </properties>

  <repositories>
    <repository>
      <id>confluent</id>
      <url>https://packages.confluent.io/maven/</url>
    </repository>
  </repositories>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.itland</groupId>
        <artifactId>contracts</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.avro</groupId>
        <artifactId>avro</artifactId>
        <version>${avro.version}</version>
      </dependency>
      <dependency>
        <groupId>io.confluent</groupId>
        <artifactId>kafka-avro-serializer</artifactId>
        <version>${confluent.version}</version>
      </dependency>
      <dependency>
        <groupId>io.confluent</groupId>
        <artifactId>kafka-streams-avro-serde</artifactId>
        <version>${confluent.version}</version>
      </dependency>
      <dependency>
        <groupId>io.confluent</groupId>
        <artifactId>kafka-schema-registry-client</artifactId>
        <version>${confluent.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
      <dependency>
        <groupId>org.flowable</groupId>
        <artifactId>flowable-spring-boot-starter-process</artifactId>
        <version>${flowable.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.avro</groupId>
          <artifactId>avro-maven-plugin</artifactId>
          <version>${avro.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
